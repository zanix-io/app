{
  "name": "@zanix/app",
  "version": "1.0.2",
  "zanix": {
    "project": "library"
  },
  "links": [],
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended",
        "jsr"
      ],
      "include": [
        "eqeqeq",
        "default-param-last",
        "camelcase",
        "no-await-in-loop",
        "no-const-assign",
        "no-eval",
        "no-non-null-asserted-optional-chain",
        "no-non-null-assertion",
        "no-self-compare",
        "no-sync-fn-in-async-fn",
        "no-throw-literal",
        "no-useless-rename"
      ]
    },
    "exclude": [
      ".dist"
    ],
    "plugins": [
      "jsr:@zanix/utils@^4.0.0/linter/deno-zanix-plugin"
    ],
    "report": "pretty"
  },
  "fmt": {
    "exclude": [
      ".dist"
    ],
    "proseWrap": "always",
    "indentWidth": 2,
    "singleQuote": true,
    "lineWidth": 100,
    "useTabs": false,
    "semiColons": false
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@0.224",
    "@std/testing": "jsr:@std/testing@1.0.9",
    "@std/semver": "jsr:@std/semver@^1.0.8",
    "@zanix/server": "jsr:@zanix/server@^4.0.0",
    "@zanix/errors": "jsr:@zanix/utils@^4.0.0/errors",
    "@zanix/types": "jsr:@zanix/utils@^4.0.0/types",
    "@zanix/helpers": "jsr:@zanix/utils@^4.0.0/helpers",
    "@zanix/logger": "jsr:@zanix/utils@^4.0.0/logger",
    "@zanix/validator": "jsr:@zanix/utils@^4.0.0/validator",
    "@zanix/workers": "jsr:@zanix/utils@^4.0.0/workers",
    "@zanix/datamaster/cache/types": "jsr:@zanix/datamaster@^1.7.0/cache/types",
    "@zanix/asyncmq/jobs": "jsr:@zanix/asyncmq@^0.8.0/jobs",
    "shared/": "./src/shared/",
    "typings/": "./src/typings/",
    "utils/": "./src/utils/",
    "modules/": "./src/modules/"
  },
  "scopes": {
    "./src/@tests/": {
      "@zanix/datamaster": "jsr:@zanix/datamaster@^1.7.0",
      "@zanix/datamaster/core": "jsr:@zanix/datamaster@^1.7.0/core",
      "@zanix/auth": "jsr:@zanix/auth@^1.0.0"
    }
  },
  "exports": {
    ".": "./mod.ts",
    "./runtime": "./runtime.ts",
    "./core": "./core.ts"
  },
  "nodeModulesDir": "auto",
  "publish": {
    "exclude": [
      ".github",
      "src/@tests"
    ]
  },
  "test": {
    "include": [
      "src/@tests/**/*.test.ts"
    ]
  },
  // "worker-options" backs `Worker`'s `deno: { permissions }`, needed for v7.4's `sandbox.permissions`
  // (see `SandboxDeclaration` in src/typings/manifest.ts) — required here for this package's own
  // sandboxing tests, and by any consumer app that restricts a sandboxed operation's permissions.
  "unstable": ["worker-options"]
}
