{
  "name": "@zanix/app",
  "version": "0.1.0",
  "zanix": {
    "project": "library",
    "hash": "pn287r"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended",
        "jsr"
      ],
      "include": [
        "eqeqeq",
        "default-param-last",
        "camelcase",
        "no-await-in-loop",
        "no-const-assign",
        "no-eval",
        "no-non-null-asserted-optional-chain",
        "no-non-null-assertion",
        "no-self-compare",
        "no-sync-fn-in-async-fn",
        "no-throw-literal",
        "no-useless-rename"
      ]
    },
    "exclude": [
      ".dist"
    ],
    "plugins": [
      "jsr:@zanix/utils/linter/deno-zanix-plugin"
    ],
    "report": "pretty"
  },
  "fmt": {
    "exclude": [
      ".dist"
    ],
    "proseWrap": "always",
    "indentWidth": 2,
    "singleQuote": true,
    "lineWidth": 100,
    "useTabs": false,
    "semiColons": false
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@0.224",
    "@std/testing": "jsr:@std/testing@1.0.9",
    // Local path during development (same convention `core/deno.jsonc` already uses) — this
    // package's own Etapa 4/5 work depends on `@zanix/server` changes (`registerApplicationMount`)
    // not published to JSR yet. Restore the commented line and drop this one before publishing.
    //"@zanix/server": "jsr:@zanix/server@^3.1.2",
    "@zanix/server": "../server/mod.ts",
    "@zanix/asyncmq": "jsr:@zanix/asyncmq@^0.5.1",
    // Local path during development, same reason/convention as @zanix/server above — this
    // package's Hito 5 work needs the connector shapes verified in the LOCAL datamaster repo;
    // whether an older published version matches isn't worth risking. Restore before publishing.
    //"@zanix/datamaster": "jsr:@zanix/datamaster@^1.1.0",
    "@zanix/datamaster": "../datamaster/mod.ts",
    "@zanix/datamaster/core": "jsr:@zanix/datamaster@^1.1.0/core",
    "@zanix/auth": "jsr:@zanix/auth@^0.6.1",
    "@zanix/errors": "jsr:@zanix/utils@^2.5.1/errors",
    "@zanix/helpers": "jsr:@zanix/utils@^2.5.1/helpers",
    "shared/": "./src/shared/",
    "typings/": "./src/typings/",
    "utils/": "./src/utils/",
    "modules/": "./src/modules/"
  },
  "exports": {
    ".": "./mod.ts",
    "./runtime": "./runtime.ts"
  },
  "nodeModulesDir": "auto",
  "publish": {
    "exclude": [
      ".github",
      "src/@tests"
    ]
  },
  "test": {
    "include": [
      "src/@tests/**/*.test.ts"
    ]
  }
}
