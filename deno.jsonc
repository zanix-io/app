{
  "name": "@zanix/app",
  "version": "0.1.0",
  "zanix": {
    "project": "library",
    "hash": "pn287r"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended",
        "jsr"
      ],
      "include": [
        "eqeqeq",
        "default-param-last",
        "camelcase",
        "no-await-in-loop",
        "no-const-assign",
        "no-eval",
        "no-non-null-asserted-optional-chain",
        "no-non-null-assertion",
        "no-self-compare",
        "no-sync-fn-in-async-fn",
        "no-throw-literal",
        "no-useless-rename"
      ]
    },
    "exclude": [
      ".dist"
    ],
    "plugins": [
      "jsr:@zanix/utils/linter/deno-zanix-plugin"
    ],
    "report": "pretty"
  },
  "fmt": {
    "exclude": [
      ".dist"
    ],
    "proseWrap": "always",
    "indentWidth": 2,
    "singleQuote": true,
    "lineWidth": 100,
    "useTabs": false,
    "semiColons": false
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@0.224",
    "@std/testing": "jsr:@std/testing@1.0.9",
    "@std/semver": "jsr:@std/semver@^1.0.8",
    "@zanix/server": "jsr:@zanix/server@^3.2.0",
    "@zanix/asyncmq": "jsr:@zanix/asyncmq@^0.6.0",
    "@zanix/datamaster": "jsr:@zanix/datamaster@^1.3.0",
    "@zanix/datamaster/core": "jsr:@zanix/datamaster@^1.3.0/core",
    "@zanix/auth": "jsr:@zanix/auth@^0.7.0",
    "@zanix/errors": "jsr:@zanix/utils@^2.6.0/errors",
    "@zanix/helpers": "jsr:@zanix/utils@^2.6.0/helpers",
    "@zanix/logger": "jsr:@zanix/utils@^2.6.0/logger",
    "@zanix/workers": "jsr:@zanix/utils@^2.6.0/workers",
    "shared/": "./src/shared/",
    "typings/": "./src/typings/",
    "utils/": "./src/utils/",
    "modules/": "./src/modules/"
  },
  "exports": {
    ".": "./mod.ts",
    "./runtime": "./runtime.ts",
    "./core": "./core.ts"
  },
  "nodeModulesDir": "auto",
  "publish": {
    "exclude": [
      ".github",
      "src/@tests"
    ]
  },
  "test": {
    "include": [
      "src/@tests/**/*.test.ts"
    ]
  },
  // "worker-options" backs `Worker`'s `deno: { permissions }`, needed for v7.4's `sandbox.permissions`
  // (see `SandboxDeclaration` in src/typings/manifest.ts) — required here for this package's own
  // sandboxing tests, and by any consumer app that restricts a sandboxed operation's permissions.
  "unstable": ["worker-options"]
}
